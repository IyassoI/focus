<file path="src/index.css">
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap');
@import "tailwindcss";

@theme {
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-display: "Montserrat", sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
  
  --color-brand-navy: #1B2A4A;
  --color-brand-steel-medium: #4A6FA5;
  --color-brand-steel-light: #8AACC8;
}

/* Custom Scroll Behavior */
html {
  scroll-behavior: smooth;
}

/* Custom styles for geometric diagonal blocks or angled dividers */
.diagonal-bg-left {
  position: relative;
}
.diagonal-bg-left::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--color-brand-navy);
  clip-path: polygon(0 0, 100% 4%, 100% 96%, 0% 100%);
  z-index: -1;
}

/* Utility to hold animations or styling */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fadeIn 0.6s ease-out forwards;
}
